# Copy to .env.local for local development.
# Production values are baked into app.config.ts when these are absent.

# ASP.NET Core API origin (no trailing slash).
EXPO_PUBLIC_API_URL=https://anaquran.runasp.net

# Optional: SignalR hub origin. Defaults to the URL returned by
# GET /api/realtime/ticket, which is correct for a direct API connection.
EXPO_PUBLIC_REALTIME_URL=

# Jitsi host that serves external_api.js. Self-hosted instances go here.
EXPO_PUBLIC_JITSI_DOMAIN=meet.143-47-237-128.sslip.io
